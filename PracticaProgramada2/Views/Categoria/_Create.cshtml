@model PracticaProgramada2.Application.Dtos.CategoriaDto

<div class="modal fade" id="modalCrearCategoria" tabindex="-1" aria-labelledby="modalCrearCategoriaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content categoria-modal">
            <form id="formCrearCategoria" asp-controller="Categoria" asp-action="CrearCategoria" method="post">
                <div class="modal-header categoria-modal-header">
                    <div class="categoria-modal-heading">
                        <span class="categoria-modal-icon"><i class="bi bi-tags"></i></span>
                        <div>
                            <span class="categoria-eyebrow">NUEVO REGISTRO</span>
                            <h5 class="modal-title" id="modalCrearCategoriaLabel">Agregar categoría</h5>
                            <p class="categoria-modal-subtitle">Ingresa los datos de la categoría médica.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre</label>
                        <div class="categoria-control">
                            <i class="bi bi-tag" aria-hidden="true"></i>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Medicamentos" maxlength="100" autocomplete="off" required />
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <div class="categoria-control categoria-textarea">
                            <i class="bi bi-card-text" aria-hidden="true"></i>
                            <textarea asp-for="Descripcion" class="form-control" placeholder="Describe la categoría" maxlength="300" rows="4" required></textarea>
                        </div>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-categoria-primary" id="btnGuardarCategoria"><i class="bi bi-check2"></i> Guardar categoría</button>
                </div>
            </form>
        </div>
    </div>
</div>
